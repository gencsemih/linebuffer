# Apache / LiteSpeed rules for the static site (cPanel "public_html").
# Edit the hostname in the canonical redirect if the domain changes.

Options -Indexes
ErrorDocument 404 /404.html
RedirectMatch 301 ^/work/?$ /
RedirectMatch 301 ^/tools/osd-designer/?$ /tools/osd-design-studio/
RedirectMatch 301 ^/tools/osd-designer/app/?$ /tools/osd-design-studio/app/

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS and one canonical host (no www)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  # Serve directory index for clean URLs; strip a stray /index.html
  RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType text/vcard .vcf
  AddCharset UTF-8 .html .css .js .svg .txt .xml .vcf
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 365 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType font/woff2 "access plus 365 days"
</IfModule>

<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/tools/[^/]+/app/#">
    Header set X-Robots-Tag "noindex, follow"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(webp|svg|png|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
