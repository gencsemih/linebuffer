# Copy to deploy.env (git-ignored) and fill in from the hosting control panel.
DEPLOY_METHOD=ssh            # ssh | ftps
DEPLOY_HOST=server.example.com
DEPLOY_PORT=22               # ssh only; cPanel hosts often use 22 or a custom port
DEPLOY_USER=cpaneluser
DEPLOY_PASS=                 # ftps only; leave empty for ssh (use a key)
DEPLOY_PATH=public_html      # document root of the domain (e.g. public_html or domains/linebuffer.io/public_html)
DEPLOY_VERIFY_CERT=yes       # ftps only

# Optional second account for the MTA-STS policy host, whose document root is
# ~/domains/mta-sts.<domain>/public_html and is outside the main account's reach.
# Create it in DirectAdmin (FTP Management) with that directory as its path.
#MTASTS_HOST=31.186.11.144
#MTASTS_USER=
#MTASTS_PASS=
#MTASTS_PATH=.
